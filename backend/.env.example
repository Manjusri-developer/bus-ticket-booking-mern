PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bus_ticket_booking
JWT_SECRET=change_this_to_a_long_random_string

# mock = local demo checkout (no Razorpay account needed)
# razorpay = real Razorpay Checkout (test or live keys)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
